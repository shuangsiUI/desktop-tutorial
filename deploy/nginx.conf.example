server {
    listen 80;
    server_name logistics.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name logistics.example.com;
    ssl_certificate /etc/letsencrypt/live/logistics.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/logistics.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:4188;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite, never append a value supplied by an untrusted client.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
}
