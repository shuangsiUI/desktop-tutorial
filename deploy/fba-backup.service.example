[Unit]
Description=FBA encrypted backup and restore verification
OnFailure=fba-alert@%n.service
[Service]
Type=oneshot
User=fba-logistics
Group=fba-logistics
WorkingDirectory=/opt/fba-logistics
EnvironmentFile=/etc/fba-logistics.env
ExecStart=/usr/bin/node /opt/fba-logistics/backend/cli/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/fba-logistics/data /mnt/fba-backups
