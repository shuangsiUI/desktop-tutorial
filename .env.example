# Supply environment variables through your service manager. No default credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=4188
PUBLIC_ORIGIN=https://logistics.example.com
DB_PATH=/opt/fba-logistics/data/logistics.sqlite
# Trust only the exact IP of your TLS reverse proxy. Do not trust arbitrary clients.
TRUSTED_PROXY_IPS=127.0.0.1

# Generate a random 32-byte Base64 key and keep it in your secret manager. Never commit it.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/opt/fba-logistics/data/backups
# Must be a separately mounted off-host backup destination in production.
BACKUP_REMOTE_DIR=/mnt/fba-backups
BACKUP_RETENTION_DAYS=30

# Separate key for encrypted authenticator secrets. Staff MFA is mandatory in production.
MFA_ENCRYPTION_KEY=
